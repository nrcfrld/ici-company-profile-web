---
interface Props {
  name: 'arrow' | 'download' | 'menu' | 'close' | 'check' | 'plus';
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
---

{name === 'arrow' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M5 19 19 5M9 5h10v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'download' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'menu' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M4 7h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
)}
{name === 'close' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
)}
{name === 'check' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="m5 12 4.5 4.5L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'plus' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
)}
